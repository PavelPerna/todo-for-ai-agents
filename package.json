{
  "name": "todo-for-ai-agents",
  "displayName": "TODO Lists for AI Agents by Pavel Perna",
  "description": "Live, human-tickable TODO lists written by your AI coding agent (Claude Code, GitHub Copilot, Cursor, …) into .todo/*.md, shown in a VS Code panel. Each list carries an onDone contract. Independent project by Pavel Perna.",
  "version": "1.3.0",
  "publisher": "PavelPerna",
  "author": {
    "name": "Pavel Perna"
  },
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/PavelPerna/todo-for-ai-agents.git"
  },
  "bugs": {
    "url": "https://github.com/PavelPerna/todo-for-ai-agents/issues"
  },
  "homepage": "https://github.com/PavelPerna/todo-for-ai-agents#readme",
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "copilot",
    "cursor",
    "ai agent",
    "todo",
    "checklist",
    "agentic"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "agentTodo",
          "title": "Agent TODO",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "agentTodo": [
        {
          "type": "webview",
          "id": "agentTodo.view",
          "name": ".todo",
          "icon": "$(checklist)"
        }
      ]
    },
    "commands": [
      {
        "command": "agentTodo.open",
        "title": "Agent TODO: Open list",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agentTodo.refresh",
        "title": "Agent TODO: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "agentTodo.showList",
        "title": "Agent TODO: Show list…"
      },
      {
        "command": "agentTodo.markAllDone",
        "title": "Agent TODO: Mark all done…"
      },
      {
        "command": "agentTodo.archive",
        "title": "Agent TODO: Archive done items…"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentTodo.open",
          "when": "view == agentTodo.view",
          "group": "navigation"
        },
        {
          "command": "agentTodo.refresh",
          "when": "view == agentTodo.view",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Agent TODO",
      "properties": {
        "agentTodo.dir": {
          "type": "string",
          "default": ".todo",
          "description": "Directory (relative to the first workspace folder) holding <name>.md and <name>.done.md lists"
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "agentTodo.mcp",
        "label": "TODO Lists for AI Agents"
      }
    ]
  }
}